# Serve o front (build do Vite) e repassa ao back só o que é dele:
#   /api/...    rotas do sistema em modo JSON
#   /static/... CSS, imagens e arquivos usados pelas telas
# As telas HTML antigas do Flask não ficam expostas por aqui.
#
# A imagem oficial do nginx troca ${PORT} e ${BACKEND_HOSTPORT} pelos valores
# do ambiente ao subir (ex.: BACKEND_HOSTPORT=backend:8001 no docker-compose,
# ou o host:porta interno do back no Render).
# O endereço do back (IP:porta) é descoberto ao subir e acompanhado a cada
# 10s por backend-upstream.envsh, que recarrega o nginx se ele mudar.

server {
    listen ${PORT};
    set $backend http://${BACKEND_UPSTREAM};
    client_max_body_size 30m;   # mesmo limite de upload do back (MAX_CONTENT_LENGTH)

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;   # geração de PDF/kit pode demorar
    }

    location /static/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
    }

    # arquivos do build com hash no nome: cache longo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # qualquer outra URL é uma tela do front (react-router)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

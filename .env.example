# Copie para .env (que o git ignora) e preencha. O docker-compose lê o .env.

# Assina o cookie de sessão. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 1 liga o modo debug do Flask (só em desenvolvimento)
FLASK_DEBUG=1

# Banco (o docker-compose já define para o serviço backend)
# DATABASE_URL=postgresql://amacor:amacor@localhost:5432/amacor

# E-mail de alertas (Gmail: use uma senha de app)
SMTP_REMETENTE=alertaamacor.siccada@gmail.com
SMTP_SENHA_APP=

# Integrações
RAPIDOC_TOKEN=
RAPIDOC_CLIENT_ID=
KOMMO_CLIENT_ID=
KOMMO_ACCESS_TOKEN=

# Endereço público do sistema (vai no QR code da entrevista). Vazio = IP da rede local
PUBLIC_URL=

# SAC: protocolo = registro ANS + AAAAMMDD + sequencial de 6 dígitos.
# O sequencial inicial só vale na primeira vez (quando as tabelas do SAC são criadas).
SAC_REGISTRO_ANS=412015
SAC_SEQUENCIAL_INICIAL=1
